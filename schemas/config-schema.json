{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "host": {
      "type": "string",
      "default": "0.0.0.0",
      "description": "Service listener address. Local CLI requests use this address, with wildcard addresses mapped to loopback."
    },
    "port": {
      "type": "integer",
      "default": 42069
    },
    "search": {
      "$ref": "#/$defs/search"
    },
    "clients": {
      "$ref": "#/$defs/clients"
    },
    "logPath": {
      "type": "string",
      "default": ""
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "ERROR",
        "DEBUG",
        "INFO",
        "WARN",
        "TRACE"
      ],
      "default": "DEBUG"
    },
    "logMaxSize": {
      "type": "integer",
      "default": 50
    },
    "logMaxBackups": {
      "type": "integer",
      "default": 3
    },
    "smartMode": {
      "type": "boolean",
      "default": false
    },
    "smartModeThreshold": {
      "type": "number",
      "default": 0.75
    },
    "fuzzyMatching": {
      "$ref": "#/$defs/fuzzyMatching"
    },
    "notifications": {
      "$ref": "#/$defs/notifications"
    },
    "apiToken": {
      "type": "string",
      "description": "Service API token. CLI commands read this value unless environment settings or --api override it.",
      "default": ""
    }
  },
  "$defs": {
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prowlarrURL": {"type": "string", "default": ""},
        "apiKey": {"type": "string", "default": ""},
        "rssInterval": {"type": "string", "default": "0s", "description": "0s disables RSS monitoring. Positive durations must be at least 10m. Targeted searches are manual only."},
        "indexerIDs": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true, "default": [], "description": "Prowlarr indexer allowlist for RSS and manual search. Empty selects all enabled torrent indexers that support the discovery mode."},
        "requestInterval": {"type": "string", "default": "10s", "description": "Go duration between Prowlarr requests. Must be at least 10s."}
      }
    },
    "clients": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "$ref": "#/$defs/client"
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["", "qbittorrent", "transmission", "deluge", "deluge-v1", "deluge-v2"],
          "description": "Empty selects qbittorrent. \"deluge\" is an alias for \"deluge-v2\"."
        },
        "host": {
          "type": "string",
          "description": "Hostname or IP address of the client. Every client request fails without it."
        },
        "port": {
          "type": "integer",
          "description": "Port of the client API. Set it explicitly. Only Deluge has a fallback (58846)."
        },
        "username": {
          "type": "string",
          "default": ""
        },
        "password": {
          "type": "string",
          "default": ""
        },
        "apiKey": {
          "type": "string",
          "default": ""
        },
        "import": {
          "$ref": "#/$defs/import"
        },
        "inventory": {
          "$ref": "#/$defs/inventory"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "transmission"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "inventory": {
                "properties": {
                  "includeCategories": {
                    "maxItems": 0
                  },
                  "includeTags": {
                    "maxItems": 0
                  },
                  "excludeCategories": {
                    "maxItems": 0
                  },
                  "excludeTags": {
                    "maxItems": 0
                  }
                }
              },
              "import": {
                "allOf": [
                  {
                    "$ref": "#/$defs/import"
                  },
                  {
                    "properties": {
                      "category": {
                        "maxLength": 0
                      },
                      "downloadPath": {
                        "maxLength": 0
                      },
                      "contentLayout": {
                        "maxLength": 0
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["deluge", "deluge-v1", "deluge-v2"]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "apiKey": {
                "maxLength": 0
              },
              "inventory": {
                "properties": {
                  "includeCategories": {
                    "maxItems": 0
                  },
                  "includeTags": {
                    "maxItems": 0
                  },
                  "excludeCategories": {
                    "maxItems": 0
                  },
                  "excludeTags": {
                    "maxItems": 0
                  }
                }
              },
              "import": {
                "allOf": [
                  {
                    "$ref": "#/$defs/import"
                  },
                  {
                    "required": [
                      "savePath"
                    ],
                    "properties": {
                      "savePath": {
                        "minLength": 1
                      },
                      "tags": {
                        "maxItems": 1,
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]+$"
                        }
                      },
                      "category": {
                        "maxLength": 0
                      },
                      "downloadPath": {
                        "maxLength": 0
                      },
                      "contentLayout": {
                        "maxLength": 0
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "import"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "enum": ["transmission", "deluge", "deluge-v1", "deluge-v2"]
                }
              }
            }
          },
          "then": {
            "required": [
              "import"
            ],
            "properties": {
              "import": {
                "allOf": [
                  {
                    "$ref": "#/$defs/import"
                  },
                  {
                    "anyOf": [
                      {
                        "required": [
                          "savePath"
                        ],
                        "properties": {
                          "savePath": {
                            "minLength": 1
                          }
                        }
                      },
                      {
                        "required": [
                          "category"
                        ],
                        "properties": {
                          "category": {
                            "minLength": 1
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "savePath": {
          "type": "string",
          "default": ""
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string",
          "default": ""
        },
        "downloadPath": {
          "type": "string",
          "default": ""
        },
        "contentLayout": {
          "type": "string",
          "enum": [
            "",
            "subfolder",
            "nosubfolder",
            "original"
          ]
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "description": "qBittorrent only. With includes, seasonpackarr reads only the torrents with an include category or an include tag. It then drops the torrents with an exclude category or an exclude tag. An exclude always wins. Empty lists read every torrent.",
      "properties": {
        "includeCategories": {
          "type": "array",
          "default": [],
          "description": "Categories to read. qBittorrent filters them, so they make the read smaller.",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "includeTags": {
          "type": "array",
          "default": [],
          "description": "Tags to read. qBittorrent 4.4 or newer filters them.",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "excludeCategories": {
          "type": "array",
          "default": [],
          "description": "Categories to drop after the read. Exact names only.",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "excludeTags": {
          "type": "array",
          "default": [],
          "description": "Tags to drop after the read. Exact names only.",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "fuzzyMatching": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skipRepackCompare": {
          "type": "boolean",
          "default": false
        },
        "simplifyHdrCompare": {
          "type": "boolean",
          "default": false
        },
        "simplifyWebCompare": {
          "type": "boolean",
          "default": false
        },
        "skipYearCompare" : {
          "type": "boolean",
          "default": false
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notificationLevel": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "MATCH",
              "INFO",
              "ERROR"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "discord": {
          "type": "string",
          "default": ""
        },
        "shoutrrr": {
          "description": "Shoutrrr URLs. Each notification goes to every URL. See https://shoutrrr.nickfedor.com/latest/services/overview/",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://"
          },
          "default": []
        }
      }
    }
  }
}
