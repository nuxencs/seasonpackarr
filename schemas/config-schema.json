{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "host": {
      "type": "string",
      "default": "0.0.0.0"
    },
    "port": {
      "type": "integer",
      "default": 42069
    },
    "clients": {
      "$ref": "#/$defs/clients"
    },
    "logPath": {
      "type": "string",
      "default": ""
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "ERROR",
        "DEBUG",
        "INFO",
        "WARN",
        "TRACE"
      ],
      "default": "INFO"
    },
    "logMaxSize": {
      "type": "integer",
      "default": 50
    },
    "logMaxBackups": {
      "type": "integer",
      "default": 3
    },
    "smartMode": {
      "type": "boolean",
      "default": false
    },
    "smartModeThreshold": {
      "type": "number",
      "default": 0.75
    },
    "fuzzyMatching": {
      "$ref": "#/$defs/fuzzyMatching"
    },
    "notifications": {
      "$ref": "#/$defs/notifications"
    },
    "apiToken": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "host",
    "port",
    "clients",
    "logLevel"
  ],
  "$defs": {
    "clients": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "$ref": "#/$defs/client"
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["", "qbittorrent", "transmission", "deluge", "deluge-v1", "deluge-v2"],
          "default": "qbittorrent"
        },
        "host": {
          "type": "string",
          "default": "127.0.0.1"
        },
        "port": {
          "type": "integer",
          "default": 8080
        },
        "username": {
          "type": "string",
          "default": "admin"
        },
        "password": {
          "type": "string",
          "default": "adminadmin"
        },
        "apiKey": {
          "type": "string",
          "default": ""
        },
        "import": {
          "$ref": "#/$defs/import"
        }
      },
      "required": [
        "host"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "transmission"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "import": {
                "allOf": [
                  {
                    "$ref": "#/$defs/import"
                  },
                  {
                    "properties": {
                      "category": {
                        "maxLength": 0
                      },
                      "downloadPath": {
                        "maxLength": 0
                      },
                      "contentLayout": {
                        "maxLength": 0
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["deluge", "deluge-v1", "deluge-v2"]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "apiKey": {
                "maxLength": 0
              },
              "import": {
                "allOf": [
                  {
                    "$ref": "#/$defs/import"
                  },
                  {
                    "required": [
                      "savePath"
                    ],
                    "properties": {
                      "savePath": {
                        "minLength": 1
                      },
                      "tags": {
                        "maxItems": 1,
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]+$"
                        }
                      },
                      "category": {
                        "maxLength": 0
                      },
                      "downloadPath": {
                        "maxLength": 0
                      },
                      "contentLayout": {
                        "maxLength": 0
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "import"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "enum": ["transmission", "deluge", "deluge-v1", "deluge-v2"]
                }
              }
            }
          },
          "then": {
            "required": [
              "import"
            ],
            "properties": {
              "import": {
                "allOf": [
                  {
                    "$ref": "#/$defs/import"
                  },
                  {
                    "anyOf": [
                      {
                        "required": [
                          "savePath"
                        ],
                        "properties": {
                          "savePath": {
                            "minLength": 1
                          }
                        }
                      },
                      {
                        "required": [
                          "category"
                        ],
                        "properties": {
                          "category": {
                            "minLength": 1
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "savePath": {
          "type": "string",
          "default": ""
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "seasonpackarr"
          ]
        },
        "category": {
          "type": "string",
          "default": ""
        },
        "downloadPath": {
          "type": "string",
          "default": ""
        },
        "contentLayout": {
          "type": "string",
          "enum": [
            "",
            "subfolder",
            "nosubfolder",
            "original"
          ]
        }
      }
    },
    "fuzzyMatching": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skipRepackCompare": {
          "type": "boolean",
          "default": false
        },
        "simplifyHdrCompare": {
          "type": "boolean",
          "default": false
        },
        "simplifyWebCompare": {
          "type": "boolean",
          "default": false
        },
        "skipYearCompare" : {
          "type": "boolean",
          "default": false
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notificationLevel": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "MATCH",
              "INFO",
              "ERROR"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "discord": {
          "type": "string",
          "default": ""
        }
      }
    }
  }
}
